# LLM (OpenAI-compatible endpoint)
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_API_KEY=sk-or-v1-...
# Use :free for OpenRouter free models, or a local model name for Ollama/llama.cpp/LM Studio
MODEL=qwen/qwen-2.5-7b-instruct:free

# Examples for local endpoints:
# OPENAI_BASE_URL=http://localhost:11434/v1
# MODEL=qwen2.5:7b

# Livepeer (empty = keyless demo mode)
LIVEPEER_API_KEY=
